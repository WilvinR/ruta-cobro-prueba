rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'danielquezada905@gmail.com';
    }

    function canWrite() {
      let d = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return d.get('blocked', false) != true && (
        d.get('exempt', false) == true
        || (d.get('exemptUntil', null) != null && request.time < d.exemptUntil)
        || request.time < d.createdAt + duration.value(15, 'd')
        || (d.get('paidUntil', null) != null && request.time < d.paidUntil + duration.value(5, 'd'))
      );
    }

    match /users/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name','email','code','createdAt'])
        && request.resource.data.createdAt == request.time;
      allow update: if isAdmin();
      // El propio usuario puede borrar su perfil durante la eliminación permanente de su cuenta.
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    match /codes/{code} {
      allow get: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null
        && (
          resource.data.uid == request.auth.uid
          || code == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.code
        );
    }

    match /datos/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid && canWrite();
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    match /config/{doc} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /mensajes/{id} {
      allow read: if request.auth != null && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid','code','name','email','text','createdAt','status'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'nuevo'
        && request.resource.data.createdAt == request.time
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 1000;
      allow update: if isAdmin();
      // Permite borrar únicamente los mensajes propios durante la eliminación de cuenta.
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    match /pendientes/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid','code','name','plan','amount','sentAt'])
        && request.resource.data.uid == uid
        && request.resource.data.sentAt == request.time;
      allow delete: if (request.auth != null && request.auth.uid == uid) || isAdmin();
    }

    match /pagos/{id} {
      allow read, write: if isAdmin();
      // Durante la eliminación de cuenta, el propietario puede leer/eliminar
      // únicamente registros de membresía ligados a su UID, código o correo.
      allow read, delete: if request.auth != null && (
        resource.data.uid == request.auth.uid
        || (resource.data.code != null
            && resource.data.code == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.code)
        || (resource.data.email != null
            && resource.data.email == request.auth.token.email)
      );
    }
  }
}
